+/// The helper that finds the timezone at a location, which is installed separately from tc2-agent
+/// since its data changes rarely and is most of the size of this binary. `TC2_TZLOOKUP` overrides
+/// where it is.
+const TZLOOKUP: &str = "/usr/bin/tc2-tzlookup";
+
+/// Where the last timezone lookup is remembered, so the lookup can be skipped when the location
+/// hasn't changed. This is a cache only: it's safe to delete.
+const TIMEZONE_CACHE: &str = "/var/cache/tc2-agent/timezone";
+
+/// The name of the timezone at a location.
+///
+/// Finding it means loading the world's timezone polygons, which takes about 100MB of memory and
+/// several seconds of CPU on the camera, and the answer only changes if the camera is moved. So
+/// it's done by `tc2-tzlookup`, a process that exits straight afterwards and so gives all of that
+/// memory back, rather than by holding the polygons in this process, where the memory sits idle
+/// outside the recording window, gets swapped out to the SD card, and (on a slow card) can stall
+/// the whole system. The last answer is also cached, keyed by location and the helper's version
+/// (so an update to its timezone data refreshes it). If the helper fails, a cached answer for
+/// another location or version is better than none.
+pub fn timezone_name(lng: f64, lat: f64) -> Result<String, String> {
+    let helper = std::env::var("TC2_TZLOOKUP").unwrap_or_else(|_| TZLOOKUP.to_string());
+    let cached = fs::read_to_string(TIMEZONE_CACHE).ok().and_then(|cached| {
+        let (key, name) = cached.split_once('\n')?;
+        let name = name.trim();
+        (!name.is_empty()).then(|| (key.to_string(), name.to_string()))
+    });
+    let version = Command::new(&helper)
+        .arg("--version")
+        .output()
+        .ok()
+        .filter(|output| output.status.success())
+        .map(|output| String::from_utf8_lossy(&output.stdout).trim().to_string());
+    // To 4 decimal places (about 10m): the same location reaches here as -43.5333 from the config
+    // and -43.533298 from the portal (an f32), which as different keys evict each other from this
+    // one-entry cache and cost a lookup each time. A timezone doesn't change within 10m, bar a
+    // camera on a border.
+    let key = format!("{} {lng:.4} {lat:.4}", version.as_deref().unwrap_or("unknown"));
+    if let Some((cached_key, name)) = &cached {
+        if version.is_some() && *cached_key == key {
+            info!("Using the cached timezone '{name}' for the location");
+            return Ok(name.clone());
+        }
+    }
+    let started = std::time::Instant::now();
+    let looked_up = Command::new(&helper)
+        .arg(format!("{lat}"))
+        .arg(format!("{lng}"))
+        .output()
+        .map_err(|e| format!("Couldn't run {helper}: {e}"))
+        .and_then(|output| {
+            let name = String::from_utf8_lossy(&output.stdout).trim().to_string();
+            if output.status.success() && !name.is_empty() {
+                Ok(name)
+            } else {
+                Err(format!(
+                    "{helper} failed ({}): {}",
+                    output.status,
+                    String::from_utf8_lossy(&output.stderr).trim()
+                ))
+            }
+        });
+    match looked_up {
+        Ok(name) => {
+            info!("Looked up timezone '{name}' for the location in {:?}", started.elapsed());
+            if let Some(dir) = Path::new(TIMEZONE_CACHE).parent() {
+                let _ = fs::create_dir_all(dir);
+            }
+            if let Err(e) = fs::write(TIMEZONE_CACHE, format!("{key}\n{name}\n")) {
+                warn!("Couldn't cache the timezone lookup: {e}");
+            }
+            Ok(name)
+        }
+        Err(e) => match cached {
+            Some((_, name)) => {
+                warn!("{e}; using the cached timezone '{name}', which may be for another location");
+                Ok(name)
+            }
+            None => Err(e),
+        },
+    }
+}
 

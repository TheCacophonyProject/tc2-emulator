+/// The child process that does the decoding.
+struct Decoder {
+    child: Child,
+    stdin: ChildStdin,
+}
+
+impl Decoder {
+    fn spawn() -> Result<Self, String> {
+        let exe = env::current_exe().map_err(|e| format!("could not find ourselves: {e}"))?;
+        let mut child = Command::new(exe)
+            .arg("--decode")
+            .stdin(Stdio::piped())
+            // Decoded lines go straight to journald from the child.
+            .stdout(Stdio::inherit())
+            .stderr(Stdio::inherit())
+            .spawn()
+            .map_err(|e| format!("could not start the log decoder: {e}"))?;
+        let stdin = child.stdin.take().ok_or("decoder stdin was not captured")?;
+        Ok(Self { child, stdin })
+    }
+
+    fn send(&mut self, bytes: &[u8]) -> io::Result<()> {
+        self.stdin.write_all(bytes)?;
+        self.stdin.flush()
+    }
+
+    fn reap(&mut self) -> std::process::ExitStatus {
+        let _ = self.child.kill();
+        self.child.wait().expect("wait on decoder child")
+    }
+}
+
+impl Drop for Decoder {
+    fn drop(&mut self) {
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+    }
+}

diff --git a/src/rp2040_link.rs b/src/rp2040_link.rs
new file mode 100644
index 0000000..ae1d391
--- /dev/null
+++ b/src/rp2040_link.rs
@@ -0,0 +1,331 @@
+//! How tc2-agent reaches the RP2040: over SPI and GPIO on a TC2, or over a socket
+//! to an emulated RP2040 (`--rp2040-link <path>`).
+//!
+//! The link is split in two, matching how it's used: the camera transfer loop
+//! owns the [`TransferPort`], and the frame socket thread owns the
+//! [`Rp2040Control`] used to restart or reprogram the RP2040.
+//!
+//! The emulated link mirrors the hardware, with tc2-agent as the SPI master.
+//! Each message is `[kind: u8][length: u32 LE][payload]`:
+//!
+//! - `PING` (RP2040 -> agent): the RP2040 has a transfer ready (GPIO7 rising edge).
+//! - `ACK` (agent -> RP2040): the agent pulled GPIO7 low to acknowledge the ping.
+//! - `READ` (agent -> RP2040): clock in `length` bytes; the payload is a u32 LE
+//!   byte count, answered with `DATA`.
+//! - `DATA` (RP2040 -> agent): the bytes clocked in.
+//! - `WRITE` (agent -> RP2040): bytes clocked out.
+//! - `RESTART` (agent -> RP2040): toggle the run pin to restart the RP2040.
+
+use crate::program_rp2040::program_rp2040;
+use log::{debug, error, info};
+use rppal::gpio::{Gpio, InputPin, OutputPin, Trigger};
+use rppal::spi::{BitOrder, Bus, Mode, Polarity, SlaveSelect, Spi};
+use std::fs::{File, OpenOptions};
+use std::io::{self, Read, Write};
+use std::path::Path;
+use std::sync::mpsc::{Receiver, RecvTimeoutError, channel};
+use std::sync::{Arc, Mutex};
+use std::thread::sleep;
+use std::time::{Duration, Instant};
+use std::{fs, process, thread};
+
+const PING: u8 = 1;
+const ACK: u8 = 2;
+const READ: u8 = 3;
+const DATA: u8 = 4;
+const WRITE: u8 = 5;
+const RESTART: u8 = 6;
+
+/// How long the emulated RP2040 has to answer a read.
+const READ_TIMEOUT: Duration = Duration::from_secs(5);
+
+/// Opens the link to the RP2040; `emulated` is the `--rp2040-link` path, if given.
+pub fn open(emulated: Option<&Path>, spi_speed_mhz: u32) -> (TransferPort, Rp2040Control) {
+    match emulated {
+        Some(path) => {
+            info!("Using emulated RP2040 at {}", path.display());
+            let link = SocketLink::open(path).unwrap_or_else(|e| {
+                error!("Failed to open emulated RP2040 link {}: {e}", path.display());
+                process::exit(1);
+            });
+            (TransferPort::Emulated(link.clone()), Rp2040Control::Emulated(link))
+        }
+        None => {
+            // For some reason when running periph.io host.ini function,
+            // needed to use the I2C in the attiny-controller, it 'holds/exports' some of the
+            // GPIO pins, so we manually 'release/unexport' them with the following.
+            let gpio_number = "7";
+            let _ = fs::write("/sys/class/gpio/unexport", gpio_number);
+
+            let gpio = Gpio::new().unwrap();
+            let mut run_pin = gpio.get(23).unwrap().into_output_high();
+            if !run_pin.is_set_high() {
+                info!("Setting run pin high to enable rp2040");
+                run_pin.set_high();
+                sleep(Duration::from_millis(1000));
+            }
+            (TransferPort::open_hardware(spi_speed_mhz), Rp2040Control::Hardware { run_pin })
+        }
+    }
+}
+
+pub enum TransferPort {
+    /// `ping_pin` is only `None` while it's briefly an output to acknowledge a ping.
+    Hardware { spi: Spi, gpio: Gpio, ping_pin: Option<InputPin> },
+    Emulated(SocketLink),
+}
+
+impl TransferPort {
+    fn open_hardware(spi_speed_mhz: u32) -> TransferPort {
+        let spi_speed = spi_speed_mhz * 1_000_000;
+        // rPi3 can handle 12Mhz (@600Mhz), may need to back it off a little to have some slack.
+        info!("Initialising SPI at {spi_speed_mhz}Mhz");
+        let spi = match Spi::new(Bus::Spi0, SlaveSelect::Ss0, spi_speed, Mode::Mode3) {
+            Ok(spi) => spi,
+            Err(e) => {
+                error!("Failed to get SPI0: {e}");
+                process::exit(1);
+            }
+        };
+        if spi.set_bits_per_word(8).is_err() {
+            error!("Failed to set SPI bits per word");
+            process::exit(1);
+        };
+        if spi.set_bit_order(BitOrder::MsbFirst).is_err() {
+            error!("Failed to set SPI output bit order");
+            process::exit(1);
+        };
+        if spi.set_ss_polarity(Polarity::ActiveLow).is_err() {
+            error!("Failed to set SPI SS polarity");
+            process::exit(1);
+        }
+        let gpio = match Gpio::new() {
+            Err(e) => {
+                error!("Failed to get GPIO: {e}");
+                process::exit(1);
+            }
+            Ok(gpio) => gpio,
+        };
+        let ping_pin = Some(get_ping_pin(&gpio));
+        TransferPort::Hardware { spi, gpio, ping_pin }
+    }
+
+    pub fn is_emulated(&self) -> bool {
+        matches!(self, TransferPort::Emulated(_))
+    }
+
+    /// Waits up to `timeout` for the RP2040 to signal that it has a transfer
+    /// ready, acknowledging it if so.
+    pub fn wait_for_transfer(&mut self, timeout: Duration) -> bool {
+        match self {
+            TransferPort::Hardware { gpio, ping_pin, .. } => {
+                let pin = ping_pin.as_mut().expect("ping pin is an input between transfers");
+                let poll_result = pin.poll_interrupt(false, Some(timeout));
+                if !matches!(poll_result, Ok(Some(_))) {
+                    return false;
+                }
+                // Briefly drive the ping pin low to acknowledge, then listen again.
+                drop(ping_pin.take());
+                let output_pin = match gpio.get(7) {
+                    Ok(pin) => pin.into_output_low(),
+                    Err(e) => {
+                        error!(
+                            "Failed to get pi ping interrupt pin ({e}), \
+        is 'dtoverlay=spi0-1cs,cs0_pin=8' set in your config.txt?"
+                        );
+                        process::exit(1);
+                    }
+                };
+                drop(output_pin);
+                *ping_pin = Some(get_ping_pin(gpio));
+                true
+            }
+            TransferPort::Emulated(link) => link.wait_for_ping(timeout).unwrap_or_else(|e| {
+                error!("Emulated RP2040 link failed: {e}");
+                process::exit(1);
+            }),
+        }
+    }
+
+    pub fn read(&mut self, buf: &mut [u8]) -> io::Result<()> {
+        match self {
+            TransferPort::Hardware { spi, .. } => spi.read(buf).map(|_| ()).map_err(io::Error::other),
+            TransferPort::Emulated(link) => link.read(buf),
+        }
+    }
+
+    pub fn write(&mut self, buf: &[u8]) -> io::Result<()> {
+        match self {
+            TransferPort::Hardware { spi, .. } => spi.write(buf).map(|_| ()).map_err(io::Error::other),
+            TransferPort::Emulated(link) => link.send(WRITE, buf),
+        }
+    }
+}
+
+/// Gets GPIO7 as an input that interrupts on the RP2040's ping.
+fn get_ping_pin(gpio: &Gpio) -> InputPin {
+    let mut pin = match gpio.get(7) {
+        Ok(pin) => pin.into_input(),
+        Err(e) => {
+            error!(
+                "Failed to get pi ping interrupt pin ({e}), \
+        is 'dtoverlay=spi0-1cs,cs0_pin=8' set in your config.txt?"
+            );
+            process::exit(1);
+        }
+    };
+    pin.clear_interrupt()
+        .map_err(|e| {
+            error!("Unable to clear pi ping interrupt pin: {e}");
+            process::exit(1);
+        })
+        .unwrap();
+
+    // NOTE: `rppal` now has a `debounce` option here which may be worth exploring.
+    // this seems to happen when save_audio fails...
+    let attempts = 100;
+    for i in 0..attempts {
+        match pin.set_interrupt(Trigger::RisingEdge, None) {
+            Ok(()) => break,
+            Err(e) => {
+                if i == attempts - 1 {
+                    error!("Unable to set pi ping interrupt: {e}");
+                    process::exit(1);
+                }
+                info!("Pin interrupts failed, trying again {e}");
+                sleep(Duration::from_millis(100));
+            }
+        }
+    }
+    pin
+}
+
+pub enum Rp2040Control {
+    Hardware { run_pin: OutputPin },
+    Emulated(SocketLink),
+}
+
+impl Rp2040Control {
+    pub fn restart(&mut self) {
+        info!("Restarting rp2040");
+        match self {
+            Rp2040Control::Hardware { run_pin } => {
+                if !run_pin.is_set_high() {
+                    run_pin.set_high();
+                    sleep(Duration::from_millis(1000));
+                }
+                run_pin.set_low();
+                sleep(Duration::from_millis(1000));
+                run_pin.set_high();
+            }
+            Rp2040Control::Emulated(link) => {
+                if let Err(e) = link.send(RESTART, &[]) {
+                    error!("Failed to restart emulated RP2040: {e}");
+                }
+            }
+        }
+    }
+
+    pub fn program(&mut self) -> io::Result<()> {
+        match self {
+            Rp2040Control::Hardware { .. } => program_rp2040(),
+            Rp2040Control::Emulated(_) => Err(io::Error::other("can't program an emulated RP2040")),
+        }
+    }
+}
+
+/// The emulated link. Clones share the connection: the transfer loop receives
+/// from it, and both halves send to it.
+#[derive(Clone)]
+pub struct SocketLink {
+    messages: Arc<Mutex<Receiver<io::Result<(u8, Vec<u8>)>>>>,
+    writer: Arc<Mutex<File>>,
+}
+
+impl SocketLink {
+    fn open(path: &Path) -> io::Result<SocketLink> {
+        let file = OpenOptions::new().read(true).write(true).open(path)?;
+        let mut reader = file.try_clone()?;
+        let (tx, rx) = channel();
+        // Read on a separate thread so waiting for a ping can time out.
+        thread::Builder::new().name("rp2040-link".to_string()).spawn(move || {
+            loop {
+                let message = read_message(&mut reader);
+                let failed = message.is_err();
+                if tx.send(message).is_err() || failed {
+                    break;
+                }
+            }
+        })?;
+        Ok(SocketLink { messages: Arc::new(Mutex::new(rx)), writer: Arc::new(Mutex::new(file)) })
+    }
+
+    fn send(&self, kind: u8, payload: &[u8]) -> io::Result<()> {
+        let mut message = Vec::with_capacity(5 + payload.len());
+        message.push(kind);
+        message.extend((payload.len() as u32).to_le_bytes());
+        message.extend(payload);
+        self.writer.lock().unwrap().write_all(&message)
+    }
+
+    fn receive(&self, timeout: Duration) -> io::Result<Option<(u8, Vec<u8>)>> {
+        match self.messages.lock().unwrap().recv_timeout(timeout) {
+            Ok(message) => message.map(Some),
+            Err(RecvTimeoutError::Timeout) => Ok(None),
+            Err(RecvTimeoutError::Disconnected) => {
+                Err(io::Error::other("emulated RP2040 link closed"))
+            }
+        }
+    }
+
+    /// Either side can restart independently, leaving stale messages behind, so
+    /// anything other than a ping is skipped.
+    fn wait_for_ping(&self, timeout: Duration) -> io::Result<bool> {
+        let deadline = Instant::now() + timeout;
+        loop {
+            let remaining = deadline.saturating_duration_since(Instant::now());
+            match self.receive(remaining)? {
+                None => return Ok(false),
+                Some((PING, _)) => {
+                    self.send(ACK, &[])?;
+                    return Ok(true);
+                }
+                Some((kind, _)) => debug!("Skipping message kind {kind} while waiting for a ping"),
+            }
+        }
+    }
+
+    fn read(&self, buf: &mut [u8]) -> io::Result<()> {
+        self.send(READ, &(buf.len() as u32).to_le_bytes())?;
+        loop {
+            match self.receive(READ_TIMEOUT)? {
+                Some((DATA, data)) if data.len() == buf.len() => {
+                    buf.copy_from_slice(&data);
+                    return Ok(());
+                }
+                Some((DATA, data)) => {
+                    return Err(io::Error::other(format!(
+                        "asked for {} bytes, got {}",
+                        buf.len(),
+                        data.len()
+                    )));
+                }
+                Some((kind, _)) => debug!("Skipping message kind {kind} while reading"),
+                None => {
+                    return Err(io::Error::other(format!(
+                        "no response from emulated RP2040 within {READ_TIMEOUT:?}"
+                    )));
+                }
+            }
+        }
+    }
+}
+
+fn read_message(reader: &mut File) -> io::Result<(u8, Vec<u8>)> {
+    let mut header = [0u8; 5];
+    reader.read_exact(&mut header)?;
+    let len = u32::from_le_bytes(header[1..5].try_into().unwrap()) as usize;
+    let mut payload = vec![0u8; len];
+    reader.read_exact(&mut payload)?;
+    Ok((header[0], payload))
+}

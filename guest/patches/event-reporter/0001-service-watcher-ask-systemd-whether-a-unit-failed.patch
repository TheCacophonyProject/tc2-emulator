+// unitFailed returns whether systemd considers the unit to have failed. That is when it is in the
+// failed state or, for a unit that is activating, when the result of its last run wasn't success
+// (which is how a failed unit looks while it waits to be restarted). Failures of any unit are
+// reported, not just Cacophony's.
+func unitFailed(ctx context.Context, conn *systemdbus.Conn, fullUnitName, activeState string) (bool, error) {
+	if activeState == "failed" {
+		return true, nil
+	}
+	unitType := unitTypeName(fullUnitName)
+	if unitType == "" {
+		return false, nil // Not a kind of unit that has a result.
+	}
+	ctx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	prop, err := conn.GetUnitTypePropertyContext(ctx, fullUnitName, unitType, "Result")
+	if err != nil {
+		return false, err
+	}
+	result := strings.Trim(prop.Value.String(), "\"")
+	return result != "" && result != "success", nil
+}
+
+// unitTypeName is the name of the D-Bus interface suffix with the Result property for a unit, from
+// the unit's file name, or "" for units that don't have one (targets, slices, devices, ...).
+func unitTypeName(fullUnitName string) string {
+	dot := strings.LastIndex(fullUnitName, ".")
+	if dot < 0 {
+		return ""
+	}
+	switch fullUnitName[dot+1:] {
+	case "service":
+		return "Service"
+	case "scope":
+		return "Scope"
+	case "socket":
+		return "Socket"
+	case "mount":
+		return "Mount"
+	case "swap":
+		return "Swap"
+	case "timer":
+		return "Timer"
+	case "path":
+		return "Path"
+	case "automount":
+		return "Automount"
+	}
+	return ""
+}

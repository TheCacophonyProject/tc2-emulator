+package servicewatcher
+
+import "testing"
+
+func TestUnitTypeName(t *testing.T) {
+	for name, want := range map[string]string{
+		"tc2-agent.service":    "Service",
+		"user@1000.service":    "Service",
+		"session-3.scope":      "Scope",
+		"dbus.socket":          "Socket",
+		"boot-firmware.mount":  "Mount",
+		"var-swap.swap":        "Swap",
+		"logrotate.timer":      "Timer",
+		"multi-user.target":    "",
+		"user.slice":           "",
+		"dev-mmcblk0p2.device": "",
+		"no-suffix":            "",
+		"trailing.dot.":        "",
+	} {
+		if got := unitTypeName(name); got != want {
+			t.Errorf("unitTypeName(%q) = %q, want %q", name, got, want)
+		}
+	}
+}

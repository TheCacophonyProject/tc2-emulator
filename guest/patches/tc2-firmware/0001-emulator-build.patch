diff --git a/src/tests/mocks/world.rs b/src/tests/mocks/world.rs
new file mode 100644
index 0000000..b9f8ff2
--- /dev/null
+++ b/src/tests/mocks/world.rs
@@ -0,0 +1,112 @@
+//! Everything outside the RP2040 that the mocked HAL talks to: the devices on the
+//! shared I2C bus (ATtiny and RTC), the Raspberry Pi on the other end of the SPI
+//! link, the Lepton, and the passage of time.
+//!
+//! The mocks call through [`with_world`], so the same firmware build can run against
+//! different worlds. The default, [`SimulatedWorld`], is the in-process simulation
+//! the tests use, driven by `TEST_SIM_STATE`. The emulator (`tc2-firmware-emu`)
+//! installs its own with [`set_world`], backed by emulated hardware and a real
+//! tc2-agent.
+//!
+//! The RP2040's own peripherals (flash, DMA, PIO) stay in the mocks, so they behave
+//! the same in every world.
+
+extern crate std;
+use crate::frame_processing::FrameBuffer;
+use crate::tests::mocks::bsp::hal::i2c::{self, I2cError};
+use crate::tests::mocks::bsp::hal::sio;
+use crate::tests::mocks::fake_shared_spi;
+use std::boxed::Box;
+use std::cell::RefCell;
+
+pub trait World {
+    /// An I2C write on the bus shared with the Pi (I2C1).
+    fn i2c_write(&mut self, address: u8, payload: &[u8]) -> Result<(), I2cError>;
+
+    /// An I2C write, then a read of `response.len()` bytes, on I2C1.
+    fn i2c_write_read(
+        &mut self,
+        address: u8,
+        request: &[u8],
+        response: &mut [u8],
+    ) -> Result<(), I2cError>;
+
+    /// Signals the Pi that a transfer is ready. True if tc2-agent acknowledged it
+    /// within `timeout_micros`.
+    fn ping_rpi(&mut self, timeout_micros: u32) -> bool;
+
+    /// Bytes the Pi clocks out of the RP2040 after a successful ping.
+    fn write_to_rpi(&mut self, bytes: &[u8]);
+
+    /// The Pi's reply to the last transfer.
+    fn read_from_rpi(&mut self, dst: &mut [u8]);
+
+    /// The RP2040's microsecond timer.
+    fn timer_micros(&mut self) -> u64;
+
+    fn delay_micros(&mut self, micros: u64);
+
+    /// Waits for the Lepton's next frame.
+    fn advance_one_frame(&mut self);
+
+    /// Copies the current Lepton frame (telemetry and pixels) into `frame_buffer`.
+    fn copy_last_frame(&mut self, frame_buffer: &mut Option<&'static mut FrameBuffer>);
+}
+
+/// The tests' simulation: devices, Pi and Lepton are all faked in `TEST_SIM_STATE`,
+/// and time only moves forward one Lepton frame at a time.
+pub struct SimulatedWorld;
+
+impl World for SimulatedWorld {
+    fn i2c_write(&mut self, address: u8, payload: &[u8]) -> Result<(), I2cError> {
+        i2c::simulated::write(address, payload)
+    }
+
+    fn i2c_write_read(
+        &mut self,
+        address: u8,
+        request: &[u8],
+        response: &mut [u8],
+    ) -> Result<(), I2cError> {
+        i2c::simulated::write_read(address, request, response)
+    }
+
+    fn ping_rpi(&mut self, _timeout_micros: u32) -> bool {
+        fake_shared_spi::simulated_rpi_answers_ping()
+    }
+
+    fn write_to_rpi(&mut self, bytes: &[u8]) {
+        let _ = fake_shared_spi::write_to_rpi(bytes);
+    }
+
+    fn read_from_rpi(&mut self, dst: &mut [u8]) {
+        let _ = fake_shared_spi::read_from_rpi(dst);
+    }
+
+    fn timer_micros(&mut self) -> u64 {
+        0
+    }
+
+    fn delay_micros(&mut self, _micros: u64) {}
+
+    fn advance_one_frame(&mut self) {
+        sio::advance_one_frame();
+    }
+
+    fn copy_last_frame(&mut self, frame_buffer: &mut Option<&'static mut FrameBuffer>) {
+        sio::copy_last_frame(frame_buffer);
+    }
+}
+
+std::thread_local! {
+    static WORLD: RefCell<Box<dyn World>> = RefCell::new(Box::new(SimulatedWorld));
+}
+
+/// Replaces the world for the current thread, which the firmware runs on.
+pub fn set_world(world: Box<dyn World>) {
+    WORLD.with(|w| *w.borrow_mut() = world);
+}
+
+pub fn with_world<R>(f: impl FnOnce(&mut dyn World) -> R) -> R {
+    WORLD.with(|w| f(w.borrow_mut().as_mut()))
+}

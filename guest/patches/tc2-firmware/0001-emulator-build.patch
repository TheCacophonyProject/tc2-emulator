+/// Whether the simulated tc2-agent answers a ping: it does once the Pi is on and
+/// tc2-agent is ready.
+pub(crate) fn simulated_rpi_answers_ping() -> bool {
+    TEST_SIM_STATE.with(|s| {
+        let s = s.borrow();
+        if s.offloads_fail_on_restart_iteration
+            .is_some_and(|r| r == s.restart_num)

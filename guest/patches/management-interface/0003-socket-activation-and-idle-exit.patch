+var (
+	// When started by systemd's socket activation, managementd exits once it has
+	// had no requests and no connected clients for this long, and is started again
+	// by the next connection to its socket.
+	idleTimeout = 10 * time.Minute
+
+	requestsInFlight atomic.Int64
+	lastRequest      atomic.Int64 // Unix nanoseconds.
+)
+
+// trackActivity records requests, so managementd knows when it's idle. This
+// includes websockets, which are requests that last as long as the client is
+// connected.
+func trackActivity(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requestsInFlight.Add(1)
+		defer func() {
+			lastRequest.Store(time.Now().UnixNano())
+			requestsInFlight.Add(-1)
+		}()
+		next.ServeHTTP(w, r)
+	})
+}
+
+func isIdle() bool {
+	return requestsInFlight.Load() == 0 && !hasActiveClients() &&
+		time.Since(time.Unix(0, lastRequest.Load())) > idleTimeout
+}
+
+// exitWhenIdle shuts the server down when nothing has used it for idleTimeout.
+// Nothing on the device needs managementd unless someone is using its web
+// interface or API, so it needn't keep running (and tc2-agent needn't keep
+// serving it frames) the rest of the time. systemd keeps listening on its
+// socket, and starts it again for the next connection.
+func exitWhenIdle(srv *http.Server) {
+	for range time.Tick(min(idleTimeout/10, time.Minute)) {
+		if !isIdle() {
+			continue
+		}
+		log.Printf("no requests or clients for %s, exiting until the next connection", idleTimeout)
+		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+		defer cancel()
+		if err := srv.Shutdown(ctx); err != nil {
+			log.Errorf("shutting down: %v", err)
+		}
+		return
+	}
+}
+
+// listen returns the socket that systemd passed (see sd_listen_fds(3)) when it
+// started managementd for a connection to managementd.socket. Otherwise,
+// started on its own, it listens on the configured port.
+func listen(port int) (l net.Listener, activated bool, err error) {
+	pid, _ := strconv.Atoi(os.Getenv("LISTEN_PID"))
+	fds, _ := strconv.Atoi(os.Getenv("LISTEN_FDS"))
+	// Not for any child processes.
+	os.Unsetenv("LISTEN_PID")
+	os.Unsetenv("LISTEN_FDS")
+	os.Unsetenv("LISTEN_FDNAMES")
+	if pid == os.Getpid() && fds >= 1 {
+		f := os.NewFile(sdListenFdsStart, "systemd socket")
+		defer f.Close()
+		l, err = net.FileListener(f)
+		return l, true, err
+	}
+	l, err = net.Listen("tcp", fmt.Sprintf(":%d", port))
+	return l, false, err
+}

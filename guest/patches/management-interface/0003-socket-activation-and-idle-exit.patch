 # --- Configuration ---
 # Define all services and what systemd action should be taken.
 # Format is "service.name:<none|restart|start>"
+# managementd is started by managementd.socket when something connects to it.
 SERVICES_TO_MANAGE=(
-    "managementd.service:start"
+    "managementd.socket:start"
 )
 
+# Earlier versions started managementd.service at boot. That's the socket's job
+# now, so stop that. If managementd is running (an upgrade) it still holds the
+# port, so the socket can't be started yet: it takes over the next time
+# managementd restarts, which salt does after an update.
+systemctl disable managementd.service 2>/dev/null || true
+if systemctl is-active --quiet managementd.service; then
+    SERVICES_TO_MANAGE=("managementd.socket:none")
+fi
+
 # Extract just the service names for the check
 service_files=()
 for config in "${SERVICES_TO_MANAGE[@]}"; do

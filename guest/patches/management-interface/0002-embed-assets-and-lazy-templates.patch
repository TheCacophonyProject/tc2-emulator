+// The html templates and static files are embedded in the binary. Embedding
+// costs nothing at startup: the files are read straight out of the binary when
+// they're needed, instead of being unpacked into memory whenever managementd starts.
+//
+//go:embed html
+var htmlFiles embed.FS
+
+//go:embed static
+var staticFiles embed.FS
+
+// StaticFS returns the embedded static files, with static/ as the root.
+func StaticFS() fs.FS {
+	static, err := fs.Sub(staticFiles, "static")
+	if err != nil {
+		panic(err)
+	}
+	return static
+}
+
+var (
+	// tmpl is our pointer to our parsed templates, see templates().
+	tmpl     *template.Template
+	tmplErr  error
+	tmplOnce sync.Once
+)
+
+// templates parses the html templates the first time they're needed. Most of the
+// time managementd runs with nobody looking at its web interface, so this isn't
+// done at startup. It also finds the device name that's inserted into the templates.
+func templates() (*template.Template, error) {
+	tmplOnce.Do(func() {
+		// The name of the device we are running this executable on.
+		deviceName := getDeviceName()
+		t := template.New("")
+		t.Funcs(template.FuncMap{"DeviceName": func() string { return deviceName }})
+		tmplErr = fs.WalkDir(htmlFiles, "html", func(path string, d fs.DirEntry, err error) error {
+			if err != nil || d.IsDir() {
+				return err
+			}
+			s, err := htmlFiles.ReadFile(path)
+			if err != nil {
+				return err
+			}
+			_, err = t.New(strings.TrimPrefix(path, "html/")).Parse(string(s))
+			return err
+		})
+		if tmplErr == nil {
+			tmpl = t
 		}
-		template.Must(t.Parse(s))
+	})
+	return tmpl, tmplErr
+}
+
+// executeTemplate writes the named template to w.
+func executeTemplate(w http.ResponseWriter, name string, data any) {
+	t, err := templates()
+	if err != nil {
+		log.Printf("failed to parse html templates: %v", err)
+		http.Error(w, "Internal server error", http.StatusInternalServerError)
+		return
+	}
+	if err := t.ExecuteTemplate(w, name, data); err != nil {
+		log.Printf("failed to execute template %s: %v", name, err)
 	}
 }
 

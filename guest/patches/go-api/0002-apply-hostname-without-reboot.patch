 		DeviceName: device.name,
@@ -193,4 +197,19 @@ var setSaltGrains = func(grains saltutil.Grains) error {
 	return saltutil.SetGrains(grains, log)
 }
 
+// applyHostname sets the running system's hostname, and restarts avahi-daemon so
+// that it advertises the device by the new name over mDNS, as Sidekick finds
+// devices by it. avahi-daemon only reads the hostname when it starts. Failures
+// are only logged, as the hostname files are written, so a reboot still applies
+// it. A variable for testing.
+var applyHostname = func(hostname string) {
+	if out, err := exec.Command("hostname", hostname).CombinedOutput(); err != nil {
+		log.Errorf("Failed to set hostname: %v: %s", err, out)
+		return
+	}
+	if out, err := exec.Command("systemctl", "try-restart", "--no-block", "avahi-daemon").CombinedOutput(); err != nil {
+		log.Errorf("Failed to restart avahi-daemon: %v: %s", err, out)
+	}
+}
+
 var Fs = afero.NewOsFs()

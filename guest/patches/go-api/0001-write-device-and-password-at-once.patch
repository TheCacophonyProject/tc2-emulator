+	// The device and its password are written at once. Otherwise, after the device
+	// reregisters, the config would have its new id with the old password for a
+	// moment, and anything reading it then would fail to authenticate.
+	c.configRW.AutoWrite = false
+	defer func() { c.configRW.AutoWrite = true }()
+	if err := c.configRW.Set(goconfig.DeviceKey, &d); err != nil {
+		return err
+	}

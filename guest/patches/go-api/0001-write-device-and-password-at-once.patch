+++ b/config_test.go
@@ -0,0 +1,72 @@
+package api
+
+import (
+	"os"
+	"path"
+	"testing"
+
+	goconfig "github.com/TheCacophonyProject/go-config"
+	"github.com/TheCacophonyProject/go-config/configtest"
+	"github.com/spf13/afero"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// writeCountingFs counts the times the config file is opened for writing.
+type writeCountingFs struct {
+	afero.Fs
+	writes int
+}
+
+func (f *writeCountingFs) OpenFile(name string, flag int, perm os.FileMode) (afero.File, error) {
+	if flag&(os.O_WRONLY|os.O_RDWR) != 0 && path.Base(name) == goconfig.ConfigFileName {
+		f.writes++
+	}
+	return f.Fs.OpenFile(name, flag, perm)
+}
+
+func (f *writeCountingFs) Create(name string) (afero.File, error) {
+	if path.Base(name) == goconfig.ConfigFileName {
+		f.writes++
+	}
+	return f.Fs.Create(name)
+}
+
+func TestConfigWritesDeviceAndPasswordAtOnce(t *testing.T) {
+	fs := &writeCountingFs{Fs: afero.NewMemMapFs()}
+	goconfig.SetFs(fs)
+	t.Cleanup(func() { goconfig.SetFs(afero.NewOsFs()) })
+	configFile := path.Join(goconfig.DefaultConfigDir, goconfig.ConfigFileName)
+	lockFile, cleanup := configtest.WriteConfigFromBytes(t, []byte(`
+[device]
+id = 1
+name = "old-name"
+group = "old-group"
+server = "https://api.example.com"
+[secrets]
+device-password = "old-password"
+`), configFile, fs)
+	t.Cleanup(cleanup)
+	goconfig.SetLockFilePath(lockFile)
+
+	conf, err := NewConfig(goconfig.DefaultConfigDir)
+	require.NoError(t, err)
+	require.NoError(t, conf.read())
+	// As after reregistering.
+	conf.DeviceID = 2
+	conf.DeviceName = "new-name"
+	conf.Group = "new-group"
+	conf.DevicePassword = "new-password"
+	fs.writes = 0
+	require.NoError(t, conf.write())
+	assert.Equal(t, 1, fs.writes, "the device and its password are written at once")
+
+	reread, err := NewConfig(goconfig.DefaultConfigDir)
+	require.NoError(t, err)
+	require.NoError(t, reread.read())
+	assert.Equal(t, 2, reread.DeviceID)
+	assert.Equal(t, "new-name", reread.DeviceName)
+	assert.Equal(t, "new-group", reread.Group)
+	assert.Equal(t, "new-password", reread.DevicePassword)
+	assert.True(t, conf.configRW.AutoWrite, "the config writes as before after")
+}

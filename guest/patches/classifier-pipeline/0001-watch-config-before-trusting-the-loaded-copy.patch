+++ b/src/piclassifier/monitorconfig.py
@@ -1,4 +1,5 @@
 import logging
+import os
 from threading import Thread
 from inotify_simple import INotify, flags
 
@@ -22,3 +23,17 @@ def monitor_file(on_modify, filename="/etc/cacophony/config.toml"):
     monitor_thread.daemon = True
     monitor_thread.start()
     return monitor_thread
+
+
+def config_mtime(filename):
+    """The config file's modification time, to take before loading it. Pass it to
+    changed_since() once monitor_file() has started watching, to find out whether the
+    file changed after it was loaded but before the watch could see it."""
+    try:
+        return os.stat(filename).st_mtime_ns
+    except OSError:
+        return None
+
+
+def changed_since(filename, mtime):
+    return mtime is not None and config_mtime(filename) != mtime

 import numpy as np
 import dbus
 import dbus.service
@@ -277,6 +278,31 @@ class Service(dbus.service.Object):
         pass
 
 
+# The recorder only waits for the root filesystem to start, so on a boot where it gets going
+# early (its imports are quick, or the boot is) the system bus may not be up when it first
+# wants it. Without the retry its D-Bus service is lost for the rest of the run, and test
+# recordings, tracking signals and the like with it.
+BUS_RETRY_SECONDS = 120
+
+
+def connect_to_system_bus(main_loop_class):
+    give_up = time.time() + BUS_RETRY_SECONDS
+    logged = False
+    while True:
+        try:
+            # private so we always get a connection on our main loop, a shared
+            # SystemBus() created earlier (or inherited over fork) without one is
+            # returned as is and the mainloop arg is silently ignored
+            return dbus.SystemBus(mainloop=main_loop_class(), private=True)
+        except dbus.exceptions.DBusException as e:
+            if time.time() > give_up:
+                raise
+            if not logged:
+                logging.info("System bus isn't up yet, retrying: %s", e)
+                logged = True
+            time.sleep(0.5)
+

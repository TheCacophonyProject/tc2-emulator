+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License
+// along with this program. If not, see <http://www.gnu.org/licenses/>.
+
+package main
+
+import (
+	"fmt"
+	"os/exec"
+	"strings"
+)
+
+// startServices starts what a reboot would after registering, without one.
+// Services that need a registered device, such as managementd, salt-minion and
+// thermal-uploader, have ConditionPathExists=/etc/salt/minion_id, so systemd
+// skipped them at boot. Starting a unit checks its conditions again, so starting
+// every skipped one starts only those that now hold. Services waiting to restart
+// after failing because the device wasn't registered, such as
+// cacophony-config-sync, are restarted now rather than when their wait ends.
+// The salt services wait for the salt grains to be set, so that salt-minion first
+// connects to the salt master with them, and salt-helper doesn't set them too.
+func startServices() error {
+	out, err := exec.Command("systemctl", "show", "--property=Wants", "--value", "multi-user.target").Output()
+	if err != nil {
+		return fmt.Errorf("listing services: %w", err)
+	}
+	wanted := strings.Fields(string(out))
+	if len(wanted) == 0 {
+		return nil
+	}
+	// Only inactive or restarting units can need starting, and listing those first
+	// is much cheaper than showing every wanted unit: the guest spends ~1s on
+	// `systemctl show` for all ~50 of them, more while everything else starts.
+	listArgs := append([]string{"list-units", "--all", "--plain", "--no-legend", "--state=inactive,auto-restart"}, wanted...)
+	out, err = exec.Command("systemctl", listArgs...).Output()
+	if err != nil {
+		return fmt.Errorf("listing inactive services: %w", err)
+	}
+	candidates := listedUnits(string(out))
+	if len(candidates) == 0 {
+		return nil
+	}
+	showArgs := append([]string{"show", "--property=Id,LoadState,ActiveState,SubState,ConditionResult"}, candidates...)
+	out, err = exec.Command("systemctl", showArgs...).Output()
+	if err != nil {
+		return fmt.Errorf("reading service states: %w", err)
+	}
+	var start, restart, startSalt, restartSalt []string
+	for _, unit := range parseUnits(string(out)) {
+		id := unit["Id"]
+		salt := saltServices[id]
+		switch {
+		case unit["LoadState"] != "loaded":
+			// Can't be started: masked, as hostapd is on Raspberry Pi OS, or missing.
+		case unit["ActiveState"] == "inactive" && unit["ConditionResult"] == "no" && salt:
+			startSalt = append(startSalt, id)
+		case unit["ActiveState"] == "inactive" && unit["ConditionResult"] == "no":
+			start = append(start, id)
+		case unit["SubState"] == "auto-restart" && salt:
+			restartSalt = append(restartSalt, id)
+		case unit["SubState"] == "auto-restart":
+			restart = append(restart, id)
+		}
+	}
+	if err := systemctl("start", "Starting services skipped at boot", start); err != nil {
+		return err
+	}
+	if err := systemctl("restart", "Restarting services waiting to restart", restart); err != nil {
+		return err
+	}
+	grainsSet.Wait()
+	if err := systemctl("start", "Starting salt services skipped at boot", startSalt); err != nil {
+		return err
+	}
+	return systemctl("restart", "Restarting salt services waiting to restart", restartSalt)
+}
+
+// saltServices use or set the salt grains.
+var saltServices = map[string]bool{
+	"salt-minion.service":  true,
+	"salt-updater.service": true,
+}
+
+// systemctl starts or restarts units without waiting for them.
+func systemctl(command, what string, units []string) error {
+	if len(units) == 0 {
+		return nil
+	}
+	log.Printf("%s: %s", what, strings.Join(units, " "))
+	if err := exec.Command("systemctl", append([]string{command, "--no-block"}, units...)...).Run(); err != nil {
+		return fmt.Errorf("%s: %w", strings.ToLower(what), err)
+	}
+	return nil
+}
+
+// listedUnits returns the unit names from `systemctl list-units --plain
+// --no-legend` output, the first field of each line, after any status mark.
+func listedUnits(out string) []string {
+	var units []string
+	for _, line := range strings.Split(out, "\n") {
+		fields := strings.Fields(strings.TrimLeft(line, "● *"))
+		if len(fields) > 0 {
+			units = append(units, fields[0])
+		}
+	}
+	return units
+}
+
+// parseUnits parses the output of `systemctl show` for several units: a block of
+// key=value lines for each, separated by blank lines.
+func parseUnits(out string) []map[string]string {
+	var units []map[string]string
+	for _, block := range strings.Split(out, "\n\n") {
+		unit := map[string]string{}
+		for _, line := range strings.Split(block, "\n") {
+			if key, value, ok := strings.Cut(line, "="); ok {
+				unit[key] = value
+			}
+		}
+		if unit["Id"] != "" {
+			units = append(units, unit)
+		}
+	}
+	return units
+}
diff --git a/cmd/device-register/services_test.go b/cmd/device-register/services_test.go
new file mode 100644
index 0000000..bea42c1
--- /dev/null
+++ b/cmd/device-register/services_test.go
@@ -0,0 +1,20 @@
+package main
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestListedUnits(t *testing.T) {
+	out := "device-register.service              loaded inactive dead Cacophony device register service\n" +
+		"hostapd.service                      masked inactive dead hostapd.service\n" +
+		"● foo.service                        not-found inactive dead foo.service\n" +
+		"\n"
+	want := []string{"device-register.service", "hostapd.service", "foo.service"}
+	if got := listedUnits(out); !reflect.DeepEqual(got, want) {
+		t.Errorf("listedUnits() = %q, want %q", got, want)
+	}
+	if got := listedUnits(""); got != nil {
+		t.Errorf("listedUnits(\"\") = %q, want none", got)
+	}
+}

+func TestSyncInstantClassifyFromAPI(t *testing.T) {
+	// Medium power mode is low power mode with instant classify.
+	s, _ := newSyncService(t, `
+[thermal-recorder]
+use-low-power-mode = false
+instant-classify = false
+updated = `+older+`
+`, map[string]any{
+		"thermalRecording": map[string]any{"useLowPowerMode": true, "instantClassify": true, "updated": newer},
+	})
+	require.NoError(t, s.sync())
+	thermal := unmarshalSection[config.ThermalRecorder](t, s, config.ThermalRecorderKey)
+	assert.True(t, thermal.UseLowPowerMode)
+	assert.True(t, thermal.InstantClassify)
+}
+
+func TestSyncInstantClassifyToAPI(t *testing.T) {
+	s, api := newSyncService(t, `
+[thermal-recorder]
+use-low-power-mode = true
+instant-classify = true
+updated = `+newer+`
+`, map[string]any{
+		"thermalRecording": map[string]any{"useLowPowerMode": false, "instantClassify": false, "updated": older},
+	})
+	require.NoError(t, s.sync())
+	assert.Equal(t, map[string]any{
+		"thermalRecording": map[string]any{"useLowPowerMode": true, "instantClassify": true, "updated": "2025-06-01T00:00:00.123Z"},
+	}, api.uploaded)
+}

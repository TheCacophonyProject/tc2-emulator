+// newAPIClient authenticates with the API as the device in the config file.
+var newAPIClient = func() (CacophonyAPIInterface, error) {
+	return api.New()
+}
+
+// checkDeviceID makes a new API client if the device in the config file is not
+// the one the current client is for. Reregistering the device, as Sidekick does
+// when moving it to another group, gives it a new id and password, and the old
+// client would carry on syncing settings with the old device.
+func (s *SyncService) checkDeviceID() error {
+	var device config.Device
+	if err := s.config.Unmarshal(config.DeviceKey, &device); err != nil {
+		return err
+	}
+	if device.ID == s.apiClient.DeviceID() {
+		return nil
+	}
+	log.Infof("Device id changed from %d to %d, authenticating as the new device", s.apiClient.DeviceID(), device.ID)
+	apiClient, err := newAPIClient()
+	if err != nil {
+		return fmt.Errorf("failed to create API client: %w", err)
+	}
+	s.apiClient = apiClient
+	return nil
+}

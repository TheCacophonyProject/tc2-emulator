+// newDeviceConfig makes a config for a device with the given id, in an in-memory fs.
+func newDeviceConfig(t *testing.T, deviceID int) *config.Config {
+	fs := afero.NewMemMapFs()
+	config.SetFs(fs)
+	configFile := path.Join(configDir, config.ConfigFileName)
+	lockFile, cleanup := configtest.WriteConfigFromBytes(t, []byte(fmt.Sprintf("[device]\nid = %d\n", deviceID)), configFile, fs)
+	t.Cleanup(cleanup)
+	config.SetLockFilePath(lockFile)
+	conf, err := config.New(configDir)
+	require.NoError(t, err)
+	return conf
+}
+
+func TestCheckDeviceID(t *testing.T) {
+	clientsMade := 0
+	defaultNewAPIClient := newAPIClient
+	newAPIClient = func() (CacophonyAPIInterface, error) {
+		clientsMade++
+		return &fakeAPIClient{deviceID: 2}, nil
+	}
+	t.Cleanup(func() { newAPIClient = defaultNewAPIClient })
+
+	// Same device: keeps the client.
+	syncService := &SyncService{apiClient: &fakeAPIClient{deviceID: 1}, config: newDeviceConfig(t, 1)}
+	require.NoError(t, syncService.checkDeviceID())
+	assert.Equal(t, 0, clientsMade)
+	assert.Equal(t, 1, syncService.apiClient.DeviceID())
+
+	// Reregistered as device 2: authenticates as it.
+	syncService.config = newDeviceConfig(t, 2)
+	require.NoError(t, syncService.checkDeviceID())
+	assert.Equal(t, 1, clientsMade)
+	assert.Equal(t, 2, syncService.apiClient.DeviceID())
+}

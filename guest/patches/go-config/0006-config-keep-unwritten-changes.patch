diff --git a/config_test.go b/config_test.go
index 2444b5e..482fa40 100644
--- a/config_test.go
+++ b/config_test.go
@@ -696,3 +696,63 @@ func randString(n int) string {
 	}
 	return string(b)
 }
+
+// newFsWithConfig is newFs with a config file with the given content.
+func newFsWithConfig(t *testing.T, content string) {
+	writeEvents = false
+	fs := afero.NewMemMapFs()
+	SetFs(fs)
+	lockFileFunc, cleanupFunc := configtest.WriteConfigFromBytes(t, []byte(content), path.Join(DefaultConfigDir, ConfigFileName), fs)
+	SetLockFilePath(lockFileFunc)
+	t.Cleanup(cleanupFunc)
+}
+
+const sectionsToChange = `
+[thermal-recorder]
+use-low-power-mode = false
+[audio-recording]
+audio-mode = "Disabled"
+[windows]
+start-recording = "09:00"
+stop-recording = "17:00"
+`
+
+func checkChangedSections(t *testing.T) {
+	conf, err := New(DefaultConfigDir)
+	require.NoError(t, err)
+	var thermal ThermalRecorder
+	require.NoError(t, conf.Unmarshal(ThermalRecorderKey, &thermal))
+	assert.True(t, thermal.UseLowPowerMode)
+	var audio AudioRecording
+	require.NoError(t, conf.Unmarshal(AudioRecordingKey, &audio))
+	assert.Equal(t, "AudioOnly", audio.AudioMode)
+	var windows Windows
+	require.NoError(t, conf.Unmarshal(WindowsKey, &windows))
+	assert.Equal(t, "22:00", windows.StartRecording)
+}
+
+func TestSetSectionsThenWrite(t *testing.T) {
+	// Setting sections one after another and writing them at once, as
+	// cacophony-config-sync does, had been losing the first ones set.
+	newFsWithConfig(t, sectionsToChange)
+	conf, err := New(DefaultConfigDir)
+	require.NoError(t, err)
+	conf.AutoWrite = false
+	require.NoError(t, conf.SetFromMap(ThermalRecorderKey, map[string]any{"use-low-power-mode": true}, false))
+	require.NoError(t, conf.SetFromMap(AudioRecordingKey, map[string]any{"audio-mode": "AudioOnly"}, false))
+	require.NoError(t, conf.SetFromMap(WindowsKey, map[string]any{"start-recording": "22:00", "stop-recording": "06:00"}, false))
+	require.NoError(t, conf.Write())
+	checkChangedSections(t)
+}
+
+func TestSetMultipleSections(t *testing.T) {
+	newFsWithConfig(t, sectionsToChange)
+	conf, err := New(DefaultConfigDir)
+	require.NoError(t, err)
+	require.NoError(t, conf.SetMultipleSections(map[string]any{
+		ThermalRecorderKey: map[string]any{"use-low-power-mode": true},
+		AudioRecordingKey:  map[string]any{"audio-mode": "AudioOnly"},
+		WindowsKey:         map[string]any{"start-recording": "22:00", "stop-recording": "06:00"},
+	}))
+	checkChangedSections(t)
+}

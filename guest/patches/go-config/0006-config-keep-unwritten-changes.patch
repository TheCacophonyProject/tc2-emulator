+
+// update reads the config file again, for changes made by other processes, unless
+// there are changes that haven't been written yet. Unsetting moves the changes set
+// before into the settings read from the file, so reading it again would lose them.
 func (c *Config) update() error {
+	if c.unwritten {
+		return nil
+	}
 	return c.readInConfig()
 }
 
@@ -304,6 +313,7 @@ func (c *Config) Reload() error {
 	c.v = viper.New()
 	c.v.SetFs(fs)
 	c.v.SetConfigFile(configFile)
+	c.unwritten = false
 	return c.readInConfig()
 }
 
@@ -357,6 +367,7 @@ func (c *Config) unset(key string) error {
 		return err
 	}
 	c.v.Set(path[0]+".updated", now())
+	c.unwritten = true
 	return nil
 }
 
@@ -427,7 +438,11 @@ func (c *Config) write() error {
 		return err
 	}
 	defer c.fileLock.Unlock()

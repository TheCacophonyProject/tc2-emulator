+// batteryFromAPI completes battery settings from the API. The web portal leaves
+// out the chemistry or cell count to have the device detect it, so that they
+// are cleared rather than left as they were, and sets the battery as manually
+// configured when either is given, as managementd does.
+func batteryFromAPI(settings map[string]any) {
+	if _, ok := settings["chemistry"]; !ok {
+		settings["chemistry"] = ""
+	}
+	if _, ok := settings["manual-cell-count"]; !ok {
+		settings["manual-cell-count"] = 0
+	}
+	settings["manually-configured"] = !isEmptyValue(settings["chemistry"]) ||
+		!isEmptyValue(settings["manual-cell-count"])
+}
+
+// batteryToAPI only reports the chemistry and cell count when the battery is
+// manually configured, since otherwise the device detects them.
+func batteryToAPI(conf any, settings map[string]any) {
+	if !conf.(*config.Battery).IsManuallyConfigured() {
+		settings["chemistry"] = ""
+		settings["manualCellCount"] = 0
+	}
 }
 

+// fakeSettingsAPI keeps device settings as the API does: sections replace the
+// API's when their `updated` is newer, or either has none, and come back as JSON.
+type fakeSettingsAPI struct {
+	settings map[string]any
+	uploaded map[string]any
+}
+
+func (f *fakeSettingsAPI) DeviceID() int { return 1 }
+
+func (f *fakeSettingsAPI) GetDeviceSettings() (map[string]any, error) { return asJSON(f.settings), nil }
+
+func (f *fakeSettingsAPI) UpdateDeviceSettings(settings map[string]any) (map[string]any, error) {
+	f.uploaded = asJSON(settings)
+	if f.settings == nil {
+		f.settings = map[string]any{}
+	}
+	for key, incoming := range f.uploaded {
+		current, ok := f.settings[key].(map[string]any)
+		incomingUpdated, incomingOk := incoming.(map[string]any)["updated"].(string)
+		currentUpdated, currentOk := current["updated"].(string)
+		if !ok || !incomingOk || !currentOk || parseTime(incomingUpdated).After(parseTime(currentUpdated)) {
+			f.settings[key] = incoming
+		}
+	}
+	return asJSON(f.settings), nil
+}
+
+func parseTime(s string) time.Time {
+	t, _ := time.Parse(time.RFC3339Nano, s)
+	return t
+}
+
+func asJSON(m map[string]any) map[string]any {
+	b, err := json.Marshal(m)
+	if err != nil {
+		panic(err)
+	}
+	var out map[string]any
+	if err := json.Unmarshal(b, &out); err != nil {
+		panic(err)
+	}
+	return out
+}
+
+// syncFs is the in-memory fs of the last newSyncService.
+var syncFs afero.Fs
+
+// newSyncService syncs a config file with the given content, as device 1, with
+// fake API settings.
+func newSyncService(t *testing.T, content string, apiSettings map[string]any) (*SyncService, *fakeSettingsAPI) {
+	fs := afero.NewMemMapFs()
+	syncFs = fs
+	config.SetFs(fs)
+	configFile := path.Join(configDir, config.ConfigFileName)
+	lockFile, cleanup := configtest.WriteConfigFromBytes(t, []byte("[device]\nid = 1\n"+content), configFile, fs)
+	t.Cleanup(cleanup)
+	config.SetLockFilePath(lockFile)
+	conf, err := config.New(configDir)
+	require.NoError(t, err)
+	api := &fakeSettingsAPI{settings: asJSON(apiSettings)}
+	return &SyncService{apiClient: api, config: conf}, api
+}
+
+func unmarshalSection[T any](t *testing.T, s *SyncService, key string) T {
+	var section T
+	require.NoError(t, s.config.Reload())
+	require.NoError(t, s.config.Unmarshal(key, &section))
+	return section
+}

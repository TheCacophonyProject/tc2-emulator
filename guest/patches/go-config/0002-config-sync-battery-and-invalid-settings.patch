+func TestSyncBatteryFromPortal(t *testing.T) {
+	// The portal sets a chemistry and cell count.
+	s, api := newSyncService(t, "", map[string]any{
+		"battery": map[string]any{"chemistry": "lipo", "manualCellCount": 3, "updated": older},
+	})
+	require.NoError(t, s.sync())
+	battery := unmarshalSection[config.Battery](t, s, config.BatteryKey)
+	assert.Equal(t, "lipo", battery.Chemistry)
+	assert.Equal(t, 3, battery.ManualCellCount)
+	assert.True(t, battery.IsManuallyConfigured())
+
+	// Then "Auto-detect", which leaves both out.
+	api.settings["battery"] = map[string]any{"updated": time.Now().Add(time.Hour).Format(time.RFC3339Nano)}
+	require.NoError(t, s.sync())
+	battery = unmarshalSection[config.Battery](t, s, config.BatteryKey)
+	assert.Equal(t, "", battery.Chemistry)
+	assert.Equal(t, 0, battery.ManualCellCount)
+	assert.False(t, battery.IsManuallyConfigured())
+
+	// Just a chemistry, with the cell count detected.
+	api.settings["battery"] = map[string]any{"chemistry": "li-ion", "updated": time.Now().Add(2 * time.Hour).Format(time.RFC3339Nano)}
+	require.NoError(t, s.sync())
+	battery = unmarshalSection[config.Battery](t, s, config.BatteryKey)
+	assert.Equal(t, "li-ion", battery.Chemistry)
+	assert.Equal(t, 0, battery.ManualCellCount)
+	assert.True(t, battery.IsManuallyConfigured())
+}

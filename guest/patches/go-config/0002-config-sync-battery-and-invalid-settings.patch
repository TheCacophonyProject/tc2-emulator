+func TestSyncAppliesNewerAPISettings(t *testing.T) {
+	s, api := newSyncService(t, `
+[thermal-recorder]
+max-secs = 300
+use-low-power-mode = false
+updated = `+older+`
+[windows]
+start-recording = "-30m"
+stop-recording = "+30m"
+updated = `+older+`
+`, map[string]any{
+		"thermalRecording": map[string]any{"useLowPowerMode": true, "updated": newer},
+		"windows":          map[string]any{"startRecording": "22:00", "stopRecording": "06:00", "updated": newer},
+		"audioRecording":   map[string]any{"audioMode": "AudioOnly", "audioSeed": 42, "updated": newer},
+	})
+	require.NoError(t, s.sync())
+
+	thermal := unmarshalSection[config.ThermalRecorder](t, s, config.ThermalRecorderKey)
+	assert.True(t, thermal.UseLowPowerMode)
+	assert.Equal(t, 300, thermal.MaxSecs, "fields that aren't synced are kept")
+	windows := unmarshalSection[config.Windows](t, s, config.WindowsKey)
+	assert.Equal(t, "22:00", windows.StartRecording)
+	assert.Equal(t, "06:00", windows.StopRecording)
+	assert.True(t, windows.Updated.After(parseTime(newer)), "applying settings marks them as updated by the device")
+	audio := unmarshalSection[config.AudioRecording](t, s, config.AudioRecordingKey)
+	assert.Equal(t, "AudioOnly", audio.AudioMode)
+	assert.Equal(t, uint32(42), audio.AudioSeed)
+	// The device's older sections don't replace the API's.
+	assert.Equal(t, true, api.settings["thermalRecording"].(map[string]any)["useLowPowerMode"])
+}

+// wholeNumberIn validates that a value is a whole number from min to max, since
+// the config would otherwise truncate or wrap it to fit an integer field.
+func wholeNumberIn(min, max float64) func(any) error {
+	return func(value any) error {
+		var f float64
+		v := reflect.ValueOf(value)
+		switch {
+		case v.CanInt():
+			f = float64(v.Int())
+		case v.CanUint():
+			f = float64(v.Uint())
+		case v.CanFloat():
+			f = v.Float()
+		default:
+			return fmt.Errorf("expected a number, got %T", value)
+		}
+		if f != math.Trunc(f) || f < min || f > max {
+			return fmt.Errorf("expected a whole number from %v to %v, got %v", min, max, value)
+		}
+		return nil
+	}
+}

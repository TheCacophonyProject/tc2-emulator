+// writeConfigFile writes the config file as viper does, but keeping fractions of a
+// second in times.
+func (c *Config) writeConfigFile() error {
+	configTOML, err := encodeTOML(c.v.AllSettings())
+	if err != nil {
+		return err
+	}
+	f, err := fs.OpenFile(c.v.ConfigFileUsed(), os.O_CREATE|os.O_TRUNC|os.O_WRONLY, 0644)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	if _, err := f.Write(configTOML); err != nil {
+		return err
+	}
+	return f.Sync()
+}
+
+// encodeTOML encodes settings as TOML, as viper does, but with times to the
+// nanosecond. go-toml writes them to the second, so a section changed twice in a
+// second, as can happen when a sync takes settings and they are then changed on the
+// device, would be marked as updated at the same time both times.
+func encodeTOML(settings map[string]any) ([]byte, error) {
+	tree, err := toml.TreeFromMap(settings)
+	if err != nil {
+		return nil, err
+	}
+	keepTimeFractions(tree)
+	configTOML, err := tree.ToTomlString()
+	return []byte(configTOML), err
+}
+
+// keepTimeFractions replaces the times in tree with TOML date-times to the
+// nanosecond, which go-toml writes as they are.
+func keepTimeFractions(tree *toml.Tree) {
+	for _, key := range tree.Keys() {
+		switch value := tree.GetPath([]string{key}).(type) {
+		case *toml.Tree:
+			keepTimeFractions(value)
+		case []*toml.Tree:
+			for _, subtree := range value {
+				keepTimeFractions(subtree)
+			}
+		case time.Time:
+			tree.SetPath([]string{key}, []byte(value.Format(time.RFC3339Nano)))
+		}
+	}
+}
+
 func notSectionKeyError(key string) error {
 	return fmt.Errorf("'%s' is not a key for a section", key)

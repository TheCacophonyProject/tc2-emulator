diff --git a/time_fraction_test.go b/time_fraction_test.go
new file mode 100644
index 0000000..02524d1
--- /dev/null
+++ b/time_fraction_test.go
@@ -0,0 +1,45 @@
+package config
+
+import (
+	"path"
+	"strings"
+	"testing"
+	"time"
+
+	toml "github.com/pelletier/go-toml"
+	"github.com/spf13/afero"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestTimesKeepFractionsOfASecond(t *testing.T) {
+	newFsWithConfig(t, sectionsToChange)
+	updated := time.Date(2026, 11, 11, 14, 26, 29, 836123456, time.FixedZone("NZDT", 13*3600))
+	defer func(n func() time.Time) { now = n }(now)
+	now = func() time.Time { return updated }
+
+	conf, err := New(DefaultConfigDir)
+	require.NoError(t, err)
+	require.NoError(t, conf.SetFromMap(WindowsKey, map[string]any{"start-recording": "22:00"}, false))
+	// Then another section, which unsets keys, rebuilding the settings.
+	now = func() time.Time { return updated.Add(time.Millisecond) }
+	require.NoError(t, conf.SetFromMap(AudioRecordingKey, map[string]any{"audio-mode": "AudioOnly"}, false))
+
+	content, err := afero.ReadFile(fs, path.Join(DefaultConfigDir, ConfigFileName))
+	require.NoError(t, err)
+	// A TOML date-time, which older versions read too.
+	assert.Contains(t, string(content), "updated = 2026-11-11T14:26:29.836123456+13:00")
+	tree, err := toml.LoadBytes(content)
+	require.NoError(t, err)
+	assert.True(t, updated.Equal(tree.GetPath([]string{"windows", "updated"}).(time.Time)))
+
+	conf, err = New(DefaultConfigDir)
+	require.NoError(t, err)
+	var windows Windows
+	require.NoError(t, conf.Unmarshal(WindowsKey, &windows))
+	assert.True(t, updated.Equal(windows.Updated), "got %v", windows.Updated)
+	var audio AudioRecording
+	require.NoError(t, conf.Unmarshal(AudioRecordingKey, &audio))
+	assert.True(t, updated.Add(time.Millisecond).Equal(audio.Updated), "got %v", audio.Updated)
+	assert.False(t, strings.Contains(string(content), `updated = "`), "not as strings")
+}

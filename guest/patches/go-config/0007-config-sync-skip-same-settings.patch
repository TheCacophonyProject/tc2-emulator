+// sameSettings reports whether the settings from the API, keyed by MapKey, are the
+// ones the device has, keyed by APIKey. Only the settings the API gives are compared,
+// as JSON, since they have different types on each side.
+func sameSettings(section Section, apiSettings, deviceSettings map[string]any) bool {
+	for _, mapping := range section.Mappings {
+		if mapping.APIKey == "updated" {
+			continue
+		}
+		apiValue, ok := apiSettings[mapping.MapKey]
+		if !ok {
+			continue
+		}
+		apiJSON, apiErr := json.Marshal(apiValue)
+		deviceJSON, deviceErr := json.Marshal(deviceSettings[mapping.APIKey])
+		if apiErr != nil || deviceErr != nil || !bytes.Equal(apiJSON, deviceJSON) {
+			return false
+		}
+	}
+	return true
+}

+func TestSyncDoesNotTakeTheSameSettings(t *testing.T) {
+	// As after the device took the window from the API in the second the portal set
+	// it: the config keeps times to the second, so the API's looks newer.
+	s, api := newSyncService(t, `
+[windows]
+start-recording = "22:00"
+stop-recording = "06:00"
+updated = 2025-06-01T00:00:00Z
+`, map[string]any{
+		"windows": map[string]any{"startRecording": "22:00", "stopRecording": "06:00", "updated": "2025-06-01T00:00:00.500Z"},
+	})
+	configFile := path.Join(configDir, config.ConfigFileName)
+	before, err := afero.ReadFile(syncFs, configFile)
+	require.NoError(t, err)
+	require.NoError(t, s.sync())
+	after, err := afero.ReadFile(syncFs, configFile)
+	require.NoError(t, err)
+	assert.Equal(t, string(before), string(after), "the config isn't written again")
+
+	// A change on the portal in the same second is still taken.
+	api.settings["windows"] = map[string]any{"startRecording": "21:00", "stopRecording": "06:00", "updated": "2025-06-01T00:00:00.900Z"}
+	require.NoError(t, s.sync())
+	assert.Equal(t, "21:00", unmarshalSection[config.Windows](t, s, config.WindowsKey).StartRecording)
+}
+
+func TestSameSettings(t *testing.T) {
+	trap := ConfigSections[len(ConfigSections)-1]
+	require.Equal(t, "trap", trap.Name)
+	device := map[string]any{
+		"enabled": true, "defaultState": "safe",
+		"target": map[string]int32{"possum": 80}, "protect": map[string]int32{},
+	}
+	// From the API, as JSON.
+	same := map[string]any{"enabled": true, "default-state": "safe", "target-species": map[string]any{"possum": 80.0}, "protect-species": map[string]any{}}
+	assert.True(t, sameSettings(trap, same, device))
+	// Only what the API gives is compared.
+	assert.True(t, sameSettings(trap, map[string]any{"enabled": true}, device))
+	assert.False(t, sameSettings(trap, map[string]any{"target-species": map[string]any{"possum": 70.0}}, device))
+	assert.False(t, sameSettings(trap, map[string]any{"enabled": false}, device))
+}

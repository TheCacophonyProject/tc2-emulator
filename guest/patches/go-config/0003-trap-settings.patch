+// trapValidateFunc validates a trap section, which can be just the keys being set.
+func trapValidateFunc(trap any) error {
+	t, err := ConvertToStruct[Trap](trap)
+	if err != nil {
+		return err
+	}
+	if t.DefaultState != "" && t.DefaultState != TrapArmed && t.DefaultState != TrapSafe {
+		return fmt.Errorf("default state must be %q or %q, got %q", TrapArmed, TrapSafe, t.DefaultState)
+	}
+	for _, species := range []map[string]int32{t.TargetSpecies, t.ProtectSpecies} {
+		for animal, confidence := range species {
+			if animal == "" {
+				return fmt.Errorf("species name can't be empty")
+			}
+			if confidence < 0 || confidence > 100 {
+				return fmt.Errorf("confidence for %s must be from 0 to 100, got %d", animal, confidence)
+			}
+		}
+	}
+	for animal := range t.TargetSpecies {
+		if _, ok := t.ProtectSpecies[animal]; ok {
+			return fmt.Errorf("%s can't be both a species to trap and to protect", animal)
+		}
+	}
+	return nil
+}

+func TestSyncTrapFromPortal(t *testing.T) {
+	// The trap's own config, sent to it by tc2-hat-comms, isn't synced.
+	s, api := newSyncService(t, `
+[trap]
+config = {cage_doors = 2}
+updated = `+older+`
+`, map[string]any{
+		"trap": map[string]any{
+			"enabled":      true,
+			"defaultState": "safe",
+			"target":       map[string]any{"possum": 80, "cat": 75},
+			"protect":      map[string]any{"kiwi": 80},
+			"updated":      newer,
+		},
+	})
+	require.NoError(t, s.sync())
+	trap := unmarshalSection[config.Trap](t, s, config.TrapKey)
+	assert.True(t, trap.Enabled)
+	assert.Equal(t, config.TrapSafe, trap.DefaultState)
+	assert.Equal(t, map[string]int32{"possum": 80, "cat": 75}, trap.TargetSpecies)
+	assert.Equal(t, map[string]int32{"kiwi": 80}, trap.ProtectSpecies)
+	assert.Equal(t, map[string]any{"cage_doors": int64(2)}, trap.Config)
+
+	// A species is removed, and the protect list left out, which clears it.
+	api.settings["trap"] = map[string]any{
+		"enabled":      false,
+		"defaultState": "armed",
+		"target":       map[string]any{"possum": 80},
+		"updated":      time.Now().Add(time.Hour).Format(time.RFC3339Nano),
+	}
+	require.NoError(t, s.sync())
+	trap = unmarshalSection[config.Trap](t, s, config.TrapKey)
+	assert.False(t, trap.Enabled)
+	assert.Equal(t, config.TrapArmed, trap.DefaultState)
+	assert.Equal(t, map[string]int32{"possum": 80}, trap.TargetSpecies)
+	assert.Empty(t, trap.ProtectSpecies)
+	assert.Equal(t, map[string]any{"cage_doors": int64(2)}, trap.Config)
+}

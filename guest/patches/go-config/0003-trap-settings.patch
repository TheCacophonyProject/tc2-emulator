+		"confidence too high": {"target": map[string]any{"possum": 101}},
+		"negative confidence": {"protect": map[string]any{"kiwi": -1}},
+		"fractional":          {"target": map[string]any{"possum": 80.5}},
+		"confidence string":   {"target": map[string]any{"possum": "high"}},
+		"species list":        {"target": []any{"possum"}},
+		"trap and protect":    {"target": map[string]any{"kiwi": 80}, "protect": map[string]any{"kiwi": 80}},
+	} {
+		t.Run(name, func(t *testing.T) {
+			invalid["enabled"] = false

+func TestSyncTrapToPortal(t *testing.T) {
+	s, api := newSyncService(t, `
+[trap]
+enabled = true
+default-state = "safe"
+target-species = {possum = 80, rodent = 60}
+config = {cage_doors = 2}
+updated = `+newer+`
+`, map[string]any{
+		"trap": map[string]any{"enabled": false, "target": map[string]any{"cat": 80}, "updated": older},
+	})
+	require.NoError(t, s.sync())
+	assert.Equal(t, map[string]any{
+		"enabled":      true,
+		"defaultState": "safe",
+		"target":       map[string]any{"possum": float64(80), "rodent": float64(60)},
+		// The API requires both lists, so an empty one is sent too.
+		"protect": map[string]any{},
+		"updated": "2025-06-01T00:00:00.123Z",
+	}, api.uploaded["trap"])
+	assert.Equal(t, api.uploaded["trap"], api.settings["trap"])
+
+	// Just enabled on the device, with the default state.
+	s, api = newSyncService(t, `
+[trap]
+enabled = true
+updated = `+newer+`
+`, nil)
+	require.NoError(t, s.sync())
+	assert.Equal(t, map[string]any{
+		"enabled":      true,
+		"defaultState": "armed",
+		"target":       map[string]any{},
+		"protect":      map[string]any{},
+		"updated":      "2025-06-01T00:00:00.123Z",
+	}, api.uploaded["trap"])
+}

+// oneOf validates that a value is one of the given strings.
+func oneOf(values ...string) func(any) error {
+	return func(value any) error {
+		s, ok := value.(string)
+		if !ok || !slices.Contains(values, s) {
+			return fmt.Errorf("expected one of %q, got %v", values, value)
+		}
+		return nil
+	}
+}
+
+// speciesConfidences validates species with the confidence needed for each, as
+// the API gives them, a map of species names to whole numbers from 0 to 100.
+func speciesConfidences(value any) error {
+	species, ok := value.(map[string]any)
+	if !ok {
+		return fmt.Errorf("expected a map of species to confidences, got %T", value)
+	}
+	validConfidence := wholeNumberIn(0, 100)
+	for animal, confidence := range species {
+		if err := validConfidence(confidence); err != nil {
+			return fmt.Errorf("confidence for %s: %w", animal, err)
+		}
+	}
+	return nil
+}
+
+// trapFromAPI clears the species lists the API leaves out, since the API
+// replaces the whole trap section when it is changed.
+func trapFromAPI(settings map[string]any) {
+	for _, key := range []string{"target-species", "protect-species"} {
+		if _, ok := settings[key]; !ok {
+			settings[key] = map[string]any{}
+		}
+	}
+}
+
+// trapToAPI always reports the default state and both species lists, as the API
+// requires them. The lists are made non-nil so that they aren't left out as empty
+// when uploaded.
+func trapToAPI(conf any, settings map[string]any) {
+	trap := conf.(*config.Trap)
+	if trap.DefaultState == "" {
+		settings["defaultState"] = config.TrapArmed
+	}
+	for apiKey, species := range map[string]map[string]int32{
+		"target":  trap.TargetSpecies,
+		"protect": trap.ProtectSpecies,
+	} {
+		if species == nil {
+			species = map[string]int32{}
+		}
+		settings[apiKey] = species
+	}
+}

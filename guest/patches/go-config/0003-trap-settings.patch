+func TestTrapValidate(t *testing.T) {
+	assert.NoError(t, trapValidateFunc(DefaultTrap()))
+	// Just some of the keys, as when setting part of the section.
+	assert.NoError(t, trapValidateFunc(map[string]any{"enabled": true}))
+	assert.NoError(t, trapValidateFunc(map[string]any{
+		"default-state":   TrapSafe,
+		"target-species":  map[string]any{"possum": 80},
+		"protect-species": map[string]any{"kiwi": 100, "bird": 0},
+		"config":          map[string]any{"cage_doors": 2},
+	}))
+
+	for name, invalid := range map[string]map[string]any{
+		"default state":    {"default-state": "maybe"},
+		"confidence":       {"target-species": map[string]any{"possum": 101}},
+		"negative":         {"protect-species": map[string]any{"kiwi": -1}},
+		"empty species":    {"target-species": map[string]any{"": 80}},
+		"trap and protect": {"target-species": map[string]any{"kiwi": 80}, "protect-species": map[string]any{"kiwi": 80}},
+		// SetFromMap converts a JSON string first; set as is, it couldn't be read back.
+		"config":           {"config": `{"cage_doors": 2}`},
+		"unknown key":      {"not-a-key": true},
+	} {
+		assert.Error(t, trapValidateFunc(invalid), name)
+	}
+}
+
+func TestSetTrap(t *testing.T) {
+	defer newFs(t, "")()
+	conf, err := New(DefaultConfigDir)
+	require.NoError(t, err)
+
+	// SetFromMap takes the config as a JSON string.
+	require.NoError(t, conf.SetFromMap(TrapKey, map[string]any{"config": `{"cage_doors": 2}`}, false))
+	require.NoError(t, conf.SetMultipleSections(map[string]any{
+		"trap": map[string]any{
+			"enabled":        true,
+			"target-species": map[string]any{"possum": 80, "cat": 80},
+		},
+	}))
+	require.NoError(t, conf.SetFromMap(TrapKey, map[string]any{
+		"default-state":  TrapSafe,
+		"target-species": map[string]any{"possum": 70},
+	}, false))
+	require.Error(t, conf.SetFromMap(TrapKey, map[string]any{"default-state": "maybe"}, false))
+
+	conf, err = New(DefaultConfigDir)
+	require.NoError(t, err)
+	var trap Trap
+	require.NoError(t, conf.Unmarshal(TrapKey, &trap))
+	assert.True(t, trap.Enabled)
+	assert.Equal(t, TrapSafe, trap.DefaultState)
+	// Species maps are replaced, not added to.
+	assert.Equal(t, map[string]int32{"possum": 70}, trap.TargetSpecies)
+	assert.Equal(t, map[string]any{"cage_doors": float64(2)}, trap.Config)
+}

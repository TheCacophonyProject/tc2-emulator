diff --git a/internal/tc2-hat-attiny/connect_test.go b/internal/tc2-hat-attiny/connect_test.go
new file mode 100644
index 0000000..2732ca6
--- /dev/null
+++ b/internal/tc2-hat-attiny/connect_test.go
@@ -0,0 +1,34 @@
+package attiny
+
+import (
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/TheCacophonyProject/tc2-hat-controller/i2crequest"
+)
+
+// A tc2-hat-i2c that hasn't started says nothing about the ATtiny: connecting must wait
+// for it, not fall through to stopping tc2-agent and reprogramming the ATtiny.
+func TestConnectWaitsForI2CServiceInsteadOfUpdatingFirmware(t *testing.T) {
+	origTx, origWait := i2crequest.TxImpl, i2cServiceWait
+	defer func() { i2crequest.TxImpl, i2cServiceWait = origTx, origWait }()
+	calls := 0
+	i2crequest.TxImpl = func(address byte, write []byte, readLen, timeout int) ([]byte, error) {
+		calls++
+		return nil, i2crequest.ErrServiceUnavailable
+	}
+	i2cServiceWait = 50 * time.Millisecond
+
+	start := time.Now()
+	_, err := connectToATtinyWithRetries(3)
+	if !errors.Is(err, i2crequest.ErrServiceUnavailable) {
+		t.Fatalf("expected the service unavailable error, got %v", err)
+	}
+	if calls < 2 {
+		t.Errorf("expected repeated attempts to connect, got %d", calls)
+	}
+	if time.Since(start) > 5*time.Second {
+		t.Errorf("took %v, expected about the wait of %v", time.Since(start), i2cServiceWait)
+	}
+}

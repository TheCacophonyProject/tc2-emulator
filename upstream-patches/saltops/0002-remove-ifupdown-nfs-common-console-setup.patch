diff --git a/tc2/basics/init.sls b/tc2/basics/init.sls
index c77467f..8e860d1 100644
--- a/tc2/basics/init.sls
+++ b/tc2/basics/init.sls
@@ -78,3 +78,22 @@ restart_swap_service:
   file.managed:
     - source: salt://tc2/basics/99-allow-downgrades
     - mode: 0644
+
+# Nothing on a TC2 uses ifupdown or NFS. NetworkManager does the wifi (driven by
+# rpi-net-manager) and the USB modem's usb0, and none of the Cacophony software
+# calls ifup. They only cost CPU at boot: networking.service runs ifupdown's hook
+# scripts, 80-ifupdown.rules runs `ifup --allow=hotplug` for each network device, and
+# 99-nfs.rules runs nfsrahead, which always fails, for each block device.
+# console-setup's udev rules set the font and UTF-8 mode of each virtual console, for the
+# HDMI console, which nobody uses.
+# The eth0 config was only for debugging with a laptop plugged in.
+/etc/network/interfaces.d/eth0:
+  file.absent
+
+ifupdown-and-nfs-purged:
+  pkg.purged:
+    - pkgs:
+      - ifupdown
+      - nfs-common
+      - console-setup
+      - console-setup-linux
